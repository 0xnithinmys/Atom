generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("EMPLOYEE") // EMPLOYEE | MANAGER | ADMIN
  managerId String?
  manager   User?    @relation("Reports", fields: [managerId], references: [id])
  reports   User[]   @relation("Reports")
  createdAt DateTime @default(now())

  goals        Goal[]       @relation("OwnerGoals")
  sharedGoals  SharedGoal[]
  checkIns     CheckIn[]
  auditLogs    AuditLog[]
  unlockedGoals GoalUnlock[] @relation("UnlockedBy")
  escalationEventsOwned EscalationEvent[] @relation("EscalationSubject")
  resolvedEscalations EscalationEvent[] @relation("EscalationResolvedBy")
  escalationDispatches EscalationDispatch[]
}

model Goal {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation("OwnerGoals", fields: [ownerId], references: [id])
  thrustArea  String
  title       String
  description String
  uomType     String   // MIN | MAX | TIMELINE | ZERO
  target      Float
  targetDate  DateTime?
  weightage   Float
  status      String   @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REWORK
  isShared    Boolean  @default(false)
  cycleYear   Int      @default(2025)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  achievements Achievement[]
  sharedGoals  SharedGoal[]
  auditLogs    AuditLog[]
  unlockEvents GoalUnlock[]
  escalationEvents EscalationEvent[]
}

model SharedGoal {
  id         String @id @default(cuid())
  goalId     String
  goal       Goal   @relation(fields: [goalId], references: [id])
  userId     String
  user       User   @relation(fields: [userId], references: [id])
  weightage  Float
  createdAt  DateTime @default(now())

  @@unique([goalId, userId])
}

model Achievement {
  id         String   @id @default(cuid())
  goalId     String
  goal       Goal     @relation(fields: [goalId], references: [id])
  quarter    Int      // 1 | 2 | 3 | 4
  actual     Float
  actualDate DateTime?
  status     String   @default("NOT_STARTED") // NOT_STARTED | ON_TRACK | COMPLETED
  score      Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  checkIns CheckIn[]
}

model CheckIn {
  id            String      @id @default(cuid())
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  managerId     String
  manager       User        @relation(fields: [managerId], references: [id])
  comment       String
  createdAt     DateTime    @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  goalId    String?
  goal      Goal?    @relation(fields: [goalId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String
  createdAt DateTime @default(now())
}

model PerformanceCycle {
  id            String   @id @default(cuid())
  year          Int      @unique
  name          String
  isActive      Boolean  @default(false)
  goalsUnlocked Boolean  @default(true)
  checkinsOpen  Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model GoalUnlock {
  id             String   @id @default(cuid())
  goalId         String
  goal           Goal     @relation(fields: [goalId], references: [id])
  unlockedById   String
  unlockedBy     User     @relation("UnlockedBy", fields: [unlockedById], references: [id])
  previousStatus String
  reason         String
  createdAt      DateTime @default(now())
}

model EscalationRule {
  id            String   @id @default(cuid())
  type          String   @unique // GOAL_NOT_SUBMITTED | GOAL_PENDING_APPROVAL | CHECKIN_NOT_COMPLETED
  enabled       Boolean  @default(true)
  thresholdDays Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EscalationEvent {
  id                 String   @id @default(cuid())
  ruleType           String
  status             String   @default("OPEN") // OPEN | RESOLVED
  cycleYear          Int
  level              Int      @default(1) // 1 employee, 2 manager, 3 skip-level/admin
  userId             String
  user               User     @relation("EscalationSubject", fields: [userId], references: [id])
  goalId             String?
  goal               Goal?    @relation(fields: [goalId], references: [id])
  firstTriggeredAt   DateTime @default(now())
  lastTriggeredAt    DateTime @default(now())
  nextEscalationAt   DateTime
  resolutionComment  String?
  resolvedAt         DateTime?
  resolvedById       String?
  resolvedBy         User?    @relation("EscalationResolvedBy", fields: [resolvedById], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  dispatches EscalationDispatch[]
}

model EscalationDispatch {
  id             String   @id @default(cuid())
  eventId        String
  event          EscalationEvent @relation(fields: [eventId], references: [id])
  recipientId    String
  recipient      User     @relation(fields: [recipientId], references: [id])
  channel        String   // IN_APP | EMAIL
  deliveryStatus String   // SENT | FAILED | SKIPPED
  message        String
  createdAt      DateTime @default(now())
}
